NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_ai_starter
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=7d

# Embeddings provider (pluggable — see src/embeddings/providers)
# "local" is a deterministic, no-API-key stub for dev/test. Set to "openai"
# once a real provider is implemented, and provide OPENAI_API_KEY.
EMBEDDINGS_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_CACHE_TTL_SECONDS=2592000
